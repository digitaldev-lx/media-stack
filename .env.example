# Copiar para .env (chmod 600). NUNCA commitar o .env. Aqui so ha nomes e descricoes.

# --- Obrigatorios ---
MEDIA_HMAC_SECRET=            # segredo HMAC partilhado com o cliente da API (openssl rand -hex 32)
FAL_KEY=                      # voz via fal.ai; sem ela a voz cai no Piper local (fallback)
PEXELS_API_KEY=               # fotos/videos de stock (https://www.pexels.com/api/)

# --- Voz ---
TTS_PROVIDER=fal              # fal | local
TTS_FALLBACK=local            # se a fal falhar / sem saldo / tecto excedido, usa Piper local
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/eleven-v3
FAL_VOICE=                    # voice_id ElevenLabs; escolher uma voz PT-PT da biblioteca e validar de ouvido
FAL_LANGUAGE_CODE=pt
FAL_STABILITY=                # 0-1, opcional
TTS_VOICE=pt_PT-tugao-medium  # voz do fallback local

# --- Tectos de custo da voz fal.ai (USD) ---
FAL_TTS_USD_PER_1K_CHARS=0.10 # confirmar em fal.ai/pricing
FAL_MAX_USD_PER_JOB=0.5
FAL_MAX_USD_PER_DAY=5

# --- Rede e activos ---
BIND_IP=127.0.0.1             # IP onde a API escuta (VPN/rede privada). Nunca 0.0.0.0
CALLBACK_ALLOWED_HOSTS=example.com   # hosts autorizados a receber callbacks (https)
ASSET_ALLOWED_HOSTS=images.pexels.com,videos.pexels.com,upload.wikimedia.org

# --- Recursos (perfil recomendado: 16 vCPU / 32 GB) ---
RENDER_CPUS=8
RENDER_MEM=12g
MAX_CONCURRENT_JOBS=2
JOB_TTL_HOURS=48
WHISPER_MODEL=base

# --- Video 3D (kind video3d; render WebGL por SwiftShader, sem GPU) ---
VIDEO3D_MAX_SECONDS=45        # pedidos mais longos falham antes do render
VIDEO3D_MAX_SCENES=6
VIDEO3D_RENDER_TIMEOUT_S=2400 # tecto de tempo do render 3D (s); o pedido nao o pode subir
RENDER_3D_WORKERS=2           # workers Chromium por render 3D (~1 vCPU e ~1 GB cada)
RENDER_3D_MAX_ACTIVE=1        # renders 3D em simultaneo; os seguintes esperam
